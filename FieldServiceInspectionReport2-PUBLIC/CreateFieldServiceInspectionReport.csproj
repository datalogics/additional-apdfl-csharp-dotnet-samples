<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <APDFLPackage Condition="'$(APDFLPackage)' == ''">LM</APDFLPackage>
  </PropertyGroup>

  <ItemGroup Condition="'$(APDFLPackage)' == 'LM'">
    <PackageReference Include="Adobe.PDF.Library.LM.NET" Version="21.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(APDFLPackage)' == 'NonLM'">
    <PackageReference Include="Adobe.PDF.Library.NET" Version="21.*" />
  </ItemGroup>
  <ItemGroup>
    <None Update="SampleData\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateAPDFLPackage" BeforeTargets="Restore;Build"
          Condition="'$(APDFLPackage)' != 'LM' and '$(APDFLPackage)' != 'NonLM'">
    <Error Text="Set APDFLPackage to LM or NonLM." />
  </Target>
</Project>
